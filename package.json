{
  "name": "gestion-usuarios",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de usuarios, grupos y mensajes entre usuarios del mismo grupo (NodeJS + Express + Pug + SQLite)",
  "type": "commonjs",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "initdb": "node ./db/init.js",
    "seed": "node ./db/init.js --seed",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^2.5.0",
    "pug": "^3.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
