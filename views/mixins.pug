//- Avatar: foto si existe, si no las iniciales
//- PARA EL GRUPO: la foto se busca en public/uploads/ con el nombre guardado en
//- usuarios.foto, así que la subida de fotos debe guardarla ahí.
mixin avatar(u)
  if u.foto
    img.avatar(src="/uploads/" + u.foto alt="Foto de " + u.nombre)
  else
    span.avatar.iniciales= (u.nombre || '?').charAt(0).toUpperCase() + (u.apellidos ? u.apellidos.charAt(0).toUpperCase() : '')
